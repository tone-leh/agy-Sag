{
  "name": "agy-session-guard",
  "version": "0.3.0",
  "description": "Antigravity Session Guard (领航哨) — Configurable context compaction threshold guard, native turn bookmarks, pre-compact Markdown export & Zero-ASAR watch daemon for Antigravity. Zero runtime dependencies, MIT licensed.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "antigravity",
    "context-compaction",
    "compact-guard",
    "markdown-export",
    "session-copilot",
    "watch-daemon",
    "zero-asar",
    "obsidian-prism-compatible"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "workbench": "node workbench/server.mjs",
    "attach": "node cli/cdp-attach.mjs --attach",
    "watch": "node cli/watch-daemon.mjs",
    "remove": "node cli/cdp-attach.mjs --remove",
    "status": "node cli/cdp-attach.mjs --status"
  }
}
